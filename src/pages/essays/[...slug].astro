---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const essays = (await getCollection('essays')).sort((a,b) => b.data.date.localeCompare(a.data.date));
  return essays.map((item, i) => ({
    params: { slug: item.slug },
    props: {
      item,
      prev: i < essays.length - 1 ? essays[i + 1] : null,
      next: i > 0 ? essays[i - 1] : null,
    },
  }));
}
const { item, prev, next } = Astro.props;
const { Content } = await item.render();
---
<ArticleLayout item={item} section="essays" sectionLabel="随笔·生活" prev={prev} next={next}>
  <Content />
</ArticleLayout>
