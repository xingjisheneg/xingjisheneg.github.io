---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getSectionEntries } from '../../content-utils';

interface Props {
  item: CollectionEntry<'essays'>;
  prev: CollectionEntry<'essays'> | null;
  next: CollectionEntry<'essays'> | null;
}

export const getStaticPaths = (async () => {
  const essays = (await getSectionEntries('essays'))
    .filter((entry): entry is CollectionEntry<'essays'> => entry.collection === 'essays');
  return essays.map((item, i) => ({
    params: { slug: item.slug },
    props: {
      item,
      prev: i < essays.length - 1 ? essays[i + 1] : null,
      next: i > 0 ? essays[i - 1] : null,
    },
  }));
}) satisfies GetStaticPaths;

const { item, prev, next } = Astro.props;
const { Content, headings } = await item.render();
---
<ArticleLayout item={item} section="essays" sectionLabel="随笔·生活" headings={headings} prev={prev} next={next}>
  <Content />
</ArticleLayout>
