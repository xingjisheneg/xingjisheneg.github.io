---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
---
<BaseLayout title={`页面未找到 · ${site.name}`} description="您访问的页面不存在，请返回首页继续浏览。">
  <div class="container">
    <div class="not-found">
      <div class="nf-code">404</div>
      <div class="nf-seal">朱批</div>
      <h1>此卷未寻得</h1>
      <p class="nf-desc">青灯之下，未见此页。或许已被归入他卷，或从未写就。</p>
      <div class="nf-actions">
        <a href="/" class="nf-link">← 回到首页</a>
        <a href="/search" class="nf-link">搜索内容</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.not-found{text-align:center;padding:4rem 1rem;max-width:36rem;margin:0 auto}
.nf-code{font-family:var(--latin);font-size:5rem;color:var(--accent);font-weight:500;line-height:1;letter-spacing:.05em}
.nf-seal{display:inline-block;margin-top:1rem;padding:.2rem .8rem;border:2px solid var(--seal);color:var(--seal);font-family:var(--kai);font-size:1rem;border-radius:4px;transform:rotate(-3deg)}
.not-found h1{font-family:var(--kai);font-size:1.8rem;font-weight:400;margin:1.5rem 0 .8rem;letter-spacing:.08em}
.nf-desc{color:var(--muted);font-size:1rem;line-height:1.9;margin-bottom:2rem}
.nf-actions{display:flex;justify-content:center;gap:1.2rem;flex-wrap:wrap}
.nf-link{font-family:var(--kai);color:var(--accent);font-size:.95rem;border:1px solid var(--rule2);border-radius:20px;padding:.5rem 1.3rem;transition:.18s}
.nf-link:hover{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 8%,transparent)}
</style>
