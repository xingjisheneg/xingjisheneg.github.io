---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { listPages, site } from '../../config';

const works = (await getCollection('works')).sort((a,b) => a.data.order - b.data.order);
const cfg = listPages.works;
---
<BaseLayout title={`${cfg.pageTitle} · ${site.name}`} active="works">
  <div class="container">
    <div class="hero" style="padding-top:0">
      <div class="vol">{cfg.vol}</div>
      <h1 style="font-size:clamp(2rem,5vw,2.8rem)">{cfg.title}</h1>
      <p class="lede">{cfg.lede}</p>
    </div>
    <div class="work-grid">
      {works.map((w, i) => <WorkCard work={w} index={i} />)}
    </div>
  </div>
</BaseLayout>
