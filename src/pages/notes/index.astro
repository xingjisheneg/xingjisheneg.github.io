---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentList from '../../components/ContentList.astro';
import { getSectionEntries } from '../../content-utils';
import { listPages, site } from '../../config';
const entries = await getSectionEntries('notes');
const cfg = listPages.notes;
---
<BaseLayout title={`${cfg.pageTitle} · ${site.name}`} active="notes">
  <div class="container collection-page">
    <header class="hero list-hero"><p class="vol">{cfg.vol}</p><h1>{cfg.title}</h1><p class="lede">{cfg.lede}</p></header>
    <ContentList entries={entries} mode="notes" />
  </div>
</BaseLayout>
