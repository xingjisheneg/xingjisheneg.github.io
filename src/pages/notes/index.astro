---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { listPages, site } from '../../config';

const notes = (await getCollection('notes')).sort((a,b) => b.data.date.localeCompare(a.data.date));
const cfg = listPages.notes;
---
<BaseLayout title={`${cfg.pageTitle} · ${site.name}`} active="notes">
  <div class="container">
    <div class="hero" style="padding-top:0">
      <div class="vol">{cfg.vol}</div>
      <h1 style="font-size:clamp(2rem,5vw,2.8rem)">{cfg.title}</h1>
      <p class="lede">{cfg.lede}</p>
    </div>
    <div class="cards">
      {notes.map(it => <ArticleCard item={it} section="notes" />)}
    </div>
  </div>
</BaseLayout>
