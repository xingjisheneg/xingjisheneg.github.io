---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getSectionEntries } from '../../content-utils';

interface Props {
  item: CollectionEntry<'notes'>;
  prev: CollectionEntry<'notes'> | null;
  next: CollectionEntry<'notes'> | null;
}

export const getStaticPaths = (async () => {
  const notes = (await getSectionEntries('notes'))
    .filter((entry): entry is CollectionEntry<'notes'> => entry.collection === 'notes');
  return notes.map((item, i) => ({
    params: { slug: item.slug },
    props: {
      item,
      prev: i < notes.length - 1 ? notes[i + 1] : null,
      next: i > 0 ? notes[i - 1] : null,
    },
  }));
}) satisfies GetStaticPaths;

const { item, prev, next } = Astro.props;
const { Content, headings } = await item.render();
---
<ArticleLayout item={item} section="notes" sectionLabel="阅读札记" headings={headings} prev={prev} next={next}>
  <Content />
</ArticleLayout>
