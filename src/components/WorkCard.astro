---
const { work, index } = Astro.props;
---
<a href={`/works/${work.slug}/`} class="work">
  <div class={`work-thumb ${work.data.cls}`}></div>
  <div class="work-info">
    <h4>{work.data.title}</h4>
    <p>{work.data.desc}</p>
    <div class="work-links">{work.data.links.map(l => <span>{l}</span>)}</div>
  </div>
</a>
