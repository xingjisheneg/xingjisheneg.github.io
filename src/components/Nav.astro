---
import { nav } from '../config';
import { getCollection } from 'astro:content';
const { active = '' } = Astro.props;
const [notes, essays, works] = await Promise.all([getCollection('notes'), getCollection('essays'), getCollection('works')]);
const counts: Record<string, number> = { notes: notes.length, essays: essays.length, works: works.length };
---
<header class="topbar">
  <div class="topbar-inner">
    <a href="/" class="brand"><span class="dot" aria-hidden="true"></span>{nav.brand}</a>
    <nav class="nav" id="nav" aria-label="主导航">
      {nav.items.map(item => (
        <a href={item.href} class:list={{ active: active === item.key }} aria-current={active === item.key ? 'page' : undefined}>
          {item.label}
          {item.key in counts && <span class="cnt" aria-label={`${counts[item.key]}条内容`}>{counts[item.key]}</span>}
        </a>
      ))}
    </nav>
    <div class="spacer"></div>
    <a href="/search/" class:list={['search-entry', { active: active === 'search' }]} aria-current={active === 'search' ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <span>搜索</span>
    </a>
    <button type="button" class="tbtn" id="themeBtn" title="切换明暗" aria-label="切换主题">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
    </button>
    <button type="button" class="tbtn menu-btn" id="menuBtn" title="展开菜单" aria-label="展开菜单" aria-expanded="false" aria-controls="nav">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</header>
