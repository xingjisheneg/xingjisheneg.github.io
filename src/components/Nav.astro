---
import { nav } from '../config';
import { getCollection } from 'astro:content';
const { active = '' } = Astro.props;
const counts = {
  notes: (await getCollection('notes')).length,
  essays: (await getCollection('essays')).length,
  works: (await getCollection('works')).length,
};
---
<header class="topbar">
  <div class="topbar-inner">
    <a href="/" class="brand"><span class="dot"></span>{nav.brand}</a>
    <nav class="nav" id="nav">
      {nav.items.map(item => (
        <a href={item.href} class={active === item.key ? 'active' : ''}>
          {item.label}
          {item.key in counts && <span class="cnt">{counts[item.key]}</span>}
        </a>
      ))}
    </nav>
    <div class="spacer"></div>
    <a href="/search" class="tbtn" title="搜索" aria-label="搜索">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
    </a>
    <button class="tbtn" id="themeBtn" title="切换明暗" aria-label="切换主题">
      <svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
    </button>
    <button class="tbtn menu-btn" id="menuBtn" title="菜单" aria-label="菜单" aria-expanded="false">
      <svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</header>
