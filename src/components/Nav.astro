---
const { active = '' } = Astro.props;
const navItems = [
  { href: '/', label: '札记', key: 'notes', count: 12 },
  { href: '/essays', label: '随笔', key: 'essays', count: 7 },
  { href: '/works', label: '作品', key: 'works', count: 5 },
  { href: '/about', label: '关于', key: 'about', count: null },
];
---
<div class="topbar">
  <div class="topbar-inner">
    <a href="/" class="brand"><span class="dot"></span>青灯黄卷</a>
    <nav class="nav" id="nav">
      {navItems.map(item => (
        <a href={item.href} class={active === item.key ? 'active' : ''}>
          {item.label}
          {item.count !== null && <span class="cnt">{item.count}</span>}
        </a>
      ))}
    </nav>
    <div class="spacer"></div>
    <a href="/search" class="tbtn" title="搜索" aria-label="搜索">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
    </a>
    <button class="tbtn" id="themeBtn" title="切换明暗" aria-label="切换主题">
      <svg viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
    </button>
    <button class="tbtn menu-btn" id="menuBtn" title="菜单" aria-label="菜单">
      <svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</div>
