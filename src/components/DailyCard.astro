---
import { calendar as calCfg, hitokoto as hkCfg } from '../config';
---
{calCfg.enabled && hkCfg.enabled && (
  <div class="dc-box" data-daily
       data-cats={hkCfg.categories.join(',')}
       data-auto={String(hkCfg.autoRefresh)}
       data-click={hkCfg.clickToRefresh ? '1' : '0'}>
    <div class="dc-label">{calCfg.label}<span class="dc-line"></span></div>
    <div class="dc-cal">
      <div class="dc-gzyear" data-cal-gzyear>丙午年</div>
      <div class="dc-solar" data-cal-solar>—</div>
      <div class="dc-week" data-cal-week>—</div>
      <div class="dc-rule"></div>
      <div class="dc-lunar" data-cal-lunar>—</div>
      <div class="dc-gzmd" data-cal-gzmd>—</div>
    </div>
    <div class="dc-quote">
      <p class="dc-text" data-hk-text>{hkCfg.fallback.text}</p>
      <p class="dc-from" data-hk-from>—— {hkCfg.fallback.from}</p>
    </div>
    <div class="dc-foot">
      <span class="dc-hint" data-hk-hint>{hkCfg.clickToRefresh ? '点击换句' : ''}</span>
      <span class="dc-seal">{calCfg.seal}</span>
    </div>
  </div>
)}
<style>
.dc-box{border:1px solid var(--rule);border-radius:var(--r);background:var(--paper);padding:1.6rem 1.5rem 1.3rem;position:relative;font-family:var(--serif);transition:border-color .2s}
.dc-box[data-click="1"]{cursor:pointer}
.dc-box:hover{border-color:var(--accent)}
.dc-label{font-family:var(--kai);color:var(--accent);font-size:.8rem;letter-spacing:.3em;display:flex;align-items:center;gap:.6rem;margin-bottom:1.3rem}
.dc-line{flex:1;height:1px;background:var(--rule)}
.dc-cal{text-align:center}
.dc-gzyear{font-family:var(--kai);font-size:1.7rem;color:var(--accent);letter-spacing:.08em;line-height:1.2;margin-bottom:.35rem}
.dc-solar{font-size:.98rem;color:var(--ink);letter-spacing:.05em;margin-bottom:.2rem}
.dc-week{font-family:var(--kai);font-size:.85rem;color:var(--muted);letter-spacing:.12em;margin-bottom:.9rem}
.dc-rule{height:1px;background:var(--rule);margin:.9rem auto;width:55%}
.dc-lunar{font-family:var(--kai);font-size:1.08rem;color:var(--ink);letter-spacing:.05em;margin-bottom:.35rem}
.dc-gzmd{font-size:.82rem;color:var(--muted);letter-spacing:.06em}
.dc-quote{position:relative;margin-top:1.2rem;padding:.9rem 0 0;border-top:1px dashed var(--rule);padding-left:.9rem;border-left:3px solid var(--accent);min-height:3rem}
.dc-text{font-family:var(--kai);font-size:1.12rem;line-height:1.85;color:var(--ink);letter-spacing:.04em;transition:opacity .25s}
.dc-from{font-family:var(--latin);font-style:italic;font-size:.82rem;color:var(--accent);margin-top:.5rem;transition:opacity .25s}
.dc-foot{display:flex;justify-content:space-between;align-items:center;margin-top:1.1rem;padding-top:.9rem;border-top:1px dashed var(--rule)}
.dc-hint{font-family:var(--kai);font-size:.74rem;color:var(--faint);letter-spacing:.12em}
.dc-seal{width:32px;height:32px;border:2px solid var(--seal);color:var(--seal);display:flex;align-items:center;justify-content:center;font-family:var(--kai);font-size:1.05rem;border-radius:4px;transform:rotate(5deg);opacity:.82}
.dc-fade{opacity:0}
</style>
<script is:inline src="https://cdn.jsdelivr.net/npm/lunar-javascript@1/lunar.js"></script>
<script>
  (function(){
    var box=document.querySelector('[data-daily]');
    if(!box)return;

    /* —— 日历部分 —— */
    function renderCal(){
      if(typeof Solar==='undefined'){setTimeout(renderCal,200);return;}
      try{
        var weekCh=['日','一','二','三','四','五','六'];
        var solar=Solar.fromDate(new Date());
        var lunar=solar.getLunar();
        box.querySelector('[data-cal-gzyear]').textContent=lunar.getYearInGanZhi()+'年 · '+lunar.getYearShengXiao();
        box.querySelector('[data-cal-solar]').textContent=solar.getYear()+'年'+solar.getMonth()+'月'+solar.getDay()+'日';
        box.querySelector('[data-cal-week]').textContent='星期'+weekCh[solar.getWeek()];
        box.querySelector('[data-cal-lunar]').textContent='农历'+lunar.getMonthInChinese()+'月'+lunar.getDayInChinese();
        box.querySelector('[data-cal-gzmd]').textContent=lunar.getMonthInGanZhi()+'月 · '+lunar.getDayInGanZhi()+'日';
      }catch(e){
        box.querySelector('[data-cal-solar]').textContent='日期推算失败';
      }
    }
    renderCal();

    /* —— 一言部分 —— */
    var cats=(box.getAttribute('data-cats')||'').split(',').filter(Boolean);
    var auto=parseInt(box.getAttribute('data-auto')||'0',10)||0;
    var click=box.getAttribute('data-click')==='1';
    var te=box.querySelector('[data-hk-text]');
    var fe=box.querySelector('[data-hk-from]');
    var hint=box.querySelector('[data-hk-hint]');
    var loading=false;
    function apply(d){
      te.textContent=d.hitokoto||'';
      var src='';
      if(d.from_who)src+=d.from_who;
      if(d.from){src+=src?('《'+d.from+'》'):d.from;}
      fe.textContent='—— '+(src||'一言');
    }
    function pickCat(){return cats.length?cats[Math.floor(Math.random()*cats.length)]:'';}
    function fade(cb){te.classList.add('dc-fade');fe.classList.add('dc-fade');setTimeout(function(){cb();te.classList.remove('dc-fade');fe.classList.remove('dc-fade');},250);}
    async function load(){
      if(loading)return;
      loading=true;
      if(hint)hint.textContent='正在获取…';
      try{
        var c=pickCat();
        var url='https://v1.hitokoto.cn/?encode=json&charset=utf-8'+(c?('&c='+c):'');
        var ctrl=new AbortController();
        var to=setTimeout(function(){ctrl.abort();},6000);
        var r=await fetch(url,{signal:ctrl.signal});
        clearTimeout(to);
        if(!r.ok)throw new Error('http '+r.status);
        var d=await r.json();
        if(!d||!d.hitokoto)throw new Error('bad data');
        fade(function(){apply(d);});
        if(hint)hint.textContent=click?'点击换句':'';
      }catch(e){
        if(hint)hint.textContent='连接一言失败';
      }finally{
        loading=false;
      }
    }
    function run(){
      load();
      if(auto>0)setInterval(load,auto*1000);
    }
    if(click){box.addEventListener('click',load);}
    var ric=window.requestIdleCallback;
    if(typeof ric==='function'){ric(run,{timeout:2000});}else{setTimeout(run,300);}
  })();
</script>
