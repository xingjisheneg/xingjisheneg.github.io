---
import { calendar as calCfg, hitokoto as hkCfg } from '../config';
---
{calCfg.enabled && hkCfg.enabled && (
  <div class="dc-box" data-daily
       data-cats={hkCfg.categories.join(',')}
       data-auto={String(hkCfg.autoRefresh)}
       data-click={hkCfg.clickToRefresh ? '1' : '0'}>
    <div class="dc-label">{calCfg.label}<span class="dc-line"></span></div>

    <!-- ▼ 视觉中心：巨大日期数字 -->
    <div class="dc-hero">
      <div class="dc-my" data-cal-my>—</div>
      <div class="dc-day-wrap"><div class="dc-day" data-cal-day>—</div></div>
      <div class="dc-week" data-cal-week>—</div>
    </div>

    <div class="dc-rule"></div>

    <!-- ▼ 辅助信息：农历 + 干支 -->
    <div class="dc-aux">
      <div class="dc-lunar" data-cal-lunar>—</div>
      <div class="dc-gz" data-cal-gz>—</div>
    </div>

    <!-- ▼ 一言题记 -->
    <div class="dc-quote">
      <p class="dc-text" data-hk-text>{hkCfg.fallback.text}</p>
      <p class="dc-from" data-hk-from>—— {hkCfg.fallback.from}</p>
    </div>

    <div class="dc-foot">
      <span class="dc-hint" data-hk-hint>{hkCfg.clickToRefresh ? '点击换句' : ''}</span>
      <div class="dc-actions">
        <button class="dc-export" data-export title="保存为图片">存图</button>
        <span class="dc-seal">{calCfg.seal}</span>
      </div>
    </div>
  </div>
)}
<style>
.dc-box{border:1px solid var(--rule);border-radius:var(--r);background:var(--paper);padding:1.5rem 1.5rem 1.2rem;position:relative;font-family:var(--serif);transition:border-color .2s}
.dc-box[data-click="1"]{cursor:pointer}
.dc-box:hover{border-color:var(--accent)}
.dc-label{font-family:var(--kai);color:var(--accent);font-size:.78rem;letter-spacing:.3em;display:flex;align-items:center;gap:.6rem;margin-bottom:.8rem}
.dc-line{flex:1;height:1px;background:var(--rule)}

/* —— 视觉中心：日期数字 —— */
.dc-hero{text-align:center;padding:.3rem 0 .7rem}
.dc-my{font-family:var(--kai);font-size:.92rem;color:var(--muted);letter-spacing:.15em;margin-bottom:8px}
.dc-day-wrap{height:96px;display:flex;align-items:center;justify-content:center;margin-bottom:14px}
.dc-day{font-family:var(--latin);font-size:5.5rem;font-weight:600;color:var(--ink);line-height:1;letter-spacing:-.02em}
.dc-week{font-family:var(--kai);font-size:.82rem;color:var(--accent);letter-spacing:.2em}

.dc-rule{height:1px;background:var(--rule);margin:.5rem auto .8rem;width:60%}

/* —— 辅助信息 —— */
.dc-aux{text-align:center;margin-bottom:1rem}
.dc-lunar{font-family:var(--kai);font-size:1.02rem;color:var(--ink);letter-spacing:.05em;margin-bottom:.25rem}
.dc-gz{font-size:.76rem;color:var(--faint);letter-spacing:.08em}

/* —— 一言 —— */
.dc-quote{position:relative;padding:.85rem .9rem .8rem;border-top:1px dashed var(--rule);border-left:3px solid var(--accent);min-height:3rem}
.dc-text{font-family:var(--kai);font-size:1.08rem;line-height:1.85;color:var(--ink);letter-spacing:.04em;transition:opacity .25s}
.dc-from{font-family:var(--latin);font-style:italic;font-size:.8rem;color:var(--accent);margin-top:.45rem;transition:opacity .25s}

.dc-foot{display:flex;justify-content:space-between;align-items:center;margin-top:.9rem;padding-top:.8rem;border-top:1px dashed var(--rule)}
.dc-hint{font-family:var(--kai);font-size:.72rem;color:var(--faint);letter-spacing:.12em}
.dc-actions{display:flex;align-items:center;gap:.7rem}
.dc-export{font-family:var(--kai);font-size:.72rem;color:var(--faint);letter-spacing:.12em;background:none;border:1px solid var(--rule);border-radius:3px;padding:.2rem .55rem;cursor:pointer;transition:.18s;line-height:1.4}
.dc-export:hover{color:var(--accent);border-color:var(--accent)}
.dc-seal{width:30px;height:30px;border:2px solid var(--seal);color:var(--seal);display:flex;align-items:center;justify-content:center;font-family:var(--kai);font-size:1rem;border-radius:4px;transform:rotate(5deg);opacity:.82}
.dc-fade{opacity:0}
</style>
<script is:inline src="https://cdn.jsdelivr.net/npm/lunar-javascript@1/lunar.js"></script>
<script>
  (function(){
    var box=document.querySelector('[data-daily]');
    if(!box)return;

    /* —— 日历部分 —— */
    var monthCh=['一','二','三','四','五','六','七','八','九','十','十一','十二'];
    function renderCal(){
      if(typeof Solar==='undefined'){setTimeout(renderCal,200);return;}
      try{
        var weekCh=['日','一','二','三','四','五','六'];
        var solar=Solar.fromDate(new Date());
        var lunar=solar.getLunar();
        box.querySelector('[data-cal-day]').textContent=solar.getDay();
        box.querySelector('[data-cal-my]').textContent=monthCh[solar.getMonth()-1]+'月 · '+solar.getYear();
        box.querySelector('[data-cal-week]').textContent='星期'+weekCh[solar.getWeek()];
        box.querySelector('[data-cal-lunar]').textContent='农历'+lunar.getMonthInChinese()+'月'+lunar.getDayInChinese();
        box.querySelector('[data-cal-gz]').textContent=lunar.getYearInGanZhi()+'年·'+lunar.getYearShengXiao()+'　'+lunar.getMonthInGanZhi()+'月·'+lunar.getDayInGanZhi()+'日';
      }catch(e){
        box.querySelector('[data-cal-day]').textContent='?';
      }
    }
    renderCal();

    /* —— 一言部分 —— */
    var cats=(box.getAttribute('data-cats')||'').split(',').filter(Boolean);
    var auto=parseInt(box.getAttribute('data-auto')||'0',10)||0;
    var click=box.getAttribute('data-click')==='1';
    var te=box.querySelector('[data-hk-text]');
    var fe=box.querySelector('[data-hk-from]');
    var hint=box.querySelector('[data-hk-hint]');
    var loading=false;
    function apply(d){
      te.textContent=d.hitokoto||'';
      var src='';
      if(d.from_who)src+=d.from_who;
      if(d.from){src+=src?('《'+d.from+'》'):d.from;}
      fe.textContent='—— '+(src||'一言');
    }
    function pickCat(){return cats.length?cats[Math.floor(Math.random()*cats.length)]:'';}
    function fade(cb){te.classList.add('dc-fade');fe.classList.add('dc-fade');setTimeout(function(){cb();te.classList.remove('dc-fade');fe.classList.remove('dc-fade');},250);}
    async function load(){
      if(loading)return;
      loading=true;
      if(hint)hint.textContent='正在获取…';
      try{
        var c=pickCat();
        var url='https://v1.hitokoto.cn/?encode=json&charset=utf-8'+(c?('&c='+c):'');
        var ctrl=new AbortController();
        var to=setTimeout(function(){ctrl.abort();},6000);
        var r=await fetch(url,{signal:ctrl.signal});
        clearTimeout(to);
        if(!r.ok)throw new Error('http '+r.status);
        var d=await r.json();
        if(!d||!d.hitokoto)throw new Error('bad data');
        fade(function(){apply(d);});
        if(hint)hint.textContent=click?'点击换句':'';
      }catch(e){
        if(hint)hint.textContent='连接一言失败';
      }finally{
        loading=false;
      }
    }
    function run(){
      load();
      if(auto>0)setInterval(load,auto*1000);
    }
    if(click){box.addEventListener('click',load);}
    var ric=window.requestIdleCallback;
    if(typeof ric==='function'){ric(run,{timeout:2000});}else{setTimeout(run,300);}

    /* —— 导出图片（Canvas 2D，不修改 DOM 以保持布局精确） —— */
    var exportBtn=box.querySelector('[data-export]');
    if(exportBtn){
      exportBtn.addEventListener('click',function(e){
        e.stopPropagation();
        e.preventDefault();
        doExport();
      });

      function doExport(){
        exportBtn.textContent='生成中…';
        exportBtn.style.pointerEvents='none';
        var fontSteps=[];
        if(document.fonts){
          ['5.5rem "Cormorant Garamond"','1rem "Ma Shan Zheng"','1rem "Noto Serif SC"'].forEach(function(f){
            fontSteps.push(document.fonts.load(f).catch(function(){}));
          });
        }
        Promise.all(fontSteps)
          .then(function(){return document.fonts&&document.fonts.ready?document.fonts.ready:Promise.resolve();})
          .then(function(){return new Promise(function(r){setTimeout(r,100);});})
          .then(function(){
            var canvas=drawCardToCanvas();
            if(!canvas)throw new Error('draw failed');
            var now=new Date();
            var fn='daily-'+now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0')+'.png';
            var a=document.createElement('a');
            a.href=canvas.toDataURL('image/png');
            a.download=fn;
            a.click();
          })
          .catch(function(e){console.error(e);exportBtn.textContent='失败';})
          .finally(function(){
            exportBtn.textContent='存图';
            exportBtn.style.pointerEvents='';
          });
      }

      function drawCardToCanvas(){
        var boxRect=box.getBoundingClientRect();
        var W=boxRect.width,H=boxRect.height,dpr=2;
        var canvas=document.createElement('canvas');
        canvas.width=Math.round(W*dpr);
        canvas.height=Math.round(H*dpr);
        var ctx=canvas.getContext('2d');
        ctx.scale(dpr,dpr);

        var root=getComputedStyle(document.documentElement);
        function cv(n,f){return root.getPropertyValue(n).trim()||f;}
        var C={paper:cv('--paper','#FBF7EC'),ink:cv('--ink','#2A2520'),accent:cv('--accent','#A23A2E'),muted:cv('--muted','#6B5D4F'),faint:cv('--faint','#9C8D7B'),rule:cv('--rule','#D9CFBE'),seal:cv('--seal','#A23A2E')};

        /* 背景 + 边框（用 rule 色，不用 hover 态的 accent 色） */
        var bs=getComputedStyle(box);
        var radius=parseFloat(bs.borderRadius)||8,bw=parseFloat(bs.borderTopWidth)||1;
        ctx.fillStyle=C.paper;rr(ctx,0,0,W,H,radius);ctx.fill();
        ctx.strokeStyle=C.rule;ctx.lineWidth=bw;rr(ctx,bw/2,bw/2,W-bw,H-bw,Math.max(0,radius-bw/2));ctx.stroke();

        /* 获取元素相对卡片的位置 */
        function rp(el){var r=el.getBoundingClientRect();return{x:r.left-boxRect.left,y:r.top-boxRect.top,w:r.width,h:r.height};}

        /* 构建 canvas 可用的 font 字符串（用 px 而非 rem） */
        function fontStr(el){
          var s=getComputedStyle(el);
          var str='';
          if(s.fontStyle&&s.fontStyle!=='normal')str+=s.fontStyle+' ';
          if(s.fontWeight&&s.fontWeight!=='400'&&s.fontWeight!=='normal')str+=s.fontWeight+' ';
          str+=s.fontSize+' '+s.fontFamily;
          return str;
        }

        /* 绘制带字间距的文字 */
        function dt(el,color,align,base,ls){
          var s=getComputedStyle(el),p=rp(el);
          ctx.font=fontStr(el);ctx.fillStyle=color;ctx.textAlign=align||'left';ctx.textBaseline=base||'top';
          var text=el.textContent;
          /* 修正 line-height 导致的垂直偏移 */
          var fs=parseFloat(s.fontSize),lh=parseFloat(s.lineHeight)||fs*1.85;
          var offsetY=base==='middle'?0:(lh-fs)/2;
          if(ls){
            var sp=fs*ls,chars=text.split(''),tw=0;
            chars.forEach(function(c){tw+=ctx.measureText(c).width+sp;});tw-=sp;
            var sx=align==='center'?p.x+(p.w-tw)/2:align==='right'?p.x+p.w-tw:p.x,cx=sx;
            chars.forEach(function(c){ctx.fillText(c,cx,p.y+offsetY);cx+=ctx.measureText(c).width+sp;});
          }else{
            var tx=align==='center'?p.x+p.w/2:align==='right'?p.x+p.w:p.x;
            ctx.fillText(text,tx,p.y+offsetY);
          }
        }

        /* 标签 + 线 */
        dt(box.querySelector('.dc-label'),C.accent,'left','top',0.3);
        var lp=rp(box.querySelector('.dc-line'));
        ctx.strokeStyle=C.rule;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(lp.x,lp.y+lp.h/2);ctx.lineTo(lp.x+lp.w,lp.y+lp.h/2);ctx.stroke();
        /* 月份年份 */
        dt(box.querySelector('.dc-my'),C.muted,'center','top',0.15);
        /* 日期数字（day-wrap 内居中） */
        var dayEl=box.querySelector('.dc-day'),dwp=rp(box.querySelector('.dc-day-wrap'));
        ctx.font=fontStr(dayEl);ctx.fillStyle=C.ink;ctx.textAlign='center';ctx.textBaseline='middle';
        ctx.fillText(dayEl.textContent,dwp.x+dwp.w/2,dwp.y+dwp.h/2);
        /* 星期 */
        dt(box.querySelector('.dc-week'),C.accent,'center','top',0.2);
        /* 分隔线 */
        var rlp=rp(box.querySelector('.dc-rule'));
        ctx.strokeStyle=C.rule;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(rlp.x,rlp.y+rlp.h/2);ctx.lineTo(rlp.x+rlp.w,rlp.y+rlp.h/2);ctx.stroke();
        /* 农历 + 干支 */
        dt(box.querySelector('.dc-lunar'),C.ink,'center','top',0.05);
        dt(box.querySelector('.dc-gz'),C.faint,'center','top',0.08);
        /* 一言区域 */
        var qEl=box.querySelector('.dc-quote'),qp=rp(qEl),qs=getComputedStyle(qEl);
        ctx.strokeStyle=C.rule;ctx.lineWidth=1;ctx.setLineDash([3,3]);ctx.beginPath();ctx.moveTo(qp.x,qp.y);ctx.lineTo(qp.x+qp.w,qp.y);ctx.stroke();ctx.setLineDash([]);
        ctx.strokeStyle=C.accent;ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(qp.x,qp.y);ctx.lineTo(qp.x,qp.y+qp.h);ctx.stroke();
        var tEl=box.querySelector('.dc-text'),tes=getComputedStyle(tEl),tp=rp(tEl);
        var tlh=parseFloat(tes.lineHeight)||parseFloat(tes.fontSize)*1.85;
        ctx.font=fontStr(tEl);ctx.fillStyle=C.ink;ctx.textAlign='left';ctx.textBaseline='top';
        var qText=tEl.textContent,qW=qp.w-parseFloat(qs.paddingLeft)-parseFloat(qs.paddingRight);
        var lines=[],cur='';
        for(var i=0;i<qText.length;i++){var test=cur+qText[i];if(ctx.measureText(test).width>qW&&cur){lines.push(cur);cur=qText[i];}else cur=test;}
        if(cur)lines.push(cur);
        var ty=tp.y;lines.forEach(function(line){ctx.fillText(line,tp.x,ty);ty+=tlh;});
        var fEl=box.querySelector('.dc-from'),fp=rp(fEl);
        ctx.font=fontStr(fEl);ctx.fillStyle=C.accent;ctx.fillText(fEl.textContent,fp.x,fp.y);
        /* 底部虚线 */
        var ftp=rp(box.querySelector('.dc-foot'));
        ctx.strokeStyle=C.rule;ctx.lineWidth=1;ctx.setLineDash([3,3]);ctx.beginPath();ctx.moveTo(ftp.x,ftp.y);ctx.lineTo(ftp.x+ftp.w,ftp.y);ctx.stroke();ctx.setLineDash([]);
        /* 印章 — 不隐藏任何元素，位置精确 */
        var sEl=box.querySelector('.dc-seal'),sp=rp(sEl),ss=getComputedStyle(sEl),ssz=sp.w;
        ctx.save();ctx.translate(sp.x+ssz/2,sp.y+ssz/2);ctx.rotate(5*Math.PI/180);ctx.globalAlpha=0.82;
        ctx.strokeStyle=C.seal;ctx.lineWidth=2;ctx.strokeRect(-ssz/2+1,-ssz/2+1,ssz-2,ssz-2);
        ctx.fillStyle=C.seal;ctx.font=fontStr(sEl);ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(sEl.textContent,0,0);ctx.restore();
        return canvas;
      }
      function rr(ctx,x,y,w,h,r){
        r=Math.min(r,w/2,h/2);ctx.beginPath();ctx.moveTo(x+r,y);
        ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();
      }
    }
  })();
</script>
